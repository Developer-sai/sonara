# Copy this file to .env.local for local development.
# In Vercel, set these under Project Settings → Environment Variables.

# --- Database (required) ---
# Postgres connection string. Easiest path: Vercel dashboard → Storage →
# create a Neon Postgres database — it injects DATABASE_URL automatically.
DATABASE_URL=

# --- Auth (required) ---
# Any long random string — used to sign session cookies.
JWT_SECRET=

# --- Spotify OAuth (optional — enables real "Connect Spotify" + Wrapped's
# real listening data; free developer account at
# https://developer.spotify.com/dashboard) ---
# Add redirect URI: https://<your-domain>/api/accounts/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Google OAuth (optional — enables real YouTube / YouTube Music import;
# free at https://console.cloud.google.com) ---
# Add redirect URI: https://<your-domain>/api/accounts/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Music, SoundCloud, Deezer, Amazon Music and TIDAL don't offer public
# self-serve developer OAuth, so those "Connect" buttons use an instant
# 1-click demo mode instead — no keys needed, everything still works
# end-to-end without any of the optional vars above set.
